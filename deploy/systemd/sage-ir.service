[Unit]
Description=SAGE IR Service
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=arai
Group=arai
WorkingDirectory=/home/arai/projects/sage/src
Environment="PATH=/home/arai/projects/sage/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
ExecStart=/home/arai/projects/sage/.venv/bin/uvicorn pipeline.ir_service:app --host 127.0.0.1 --port 8420
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
