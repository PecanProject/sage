[Unit]
Description=SAGE Scientist Review UI
After=network.target sage-ir.service
Requires=sage-ir.service

[Service]
Type=simple
User=arai
Group=arai
WorkingDirectory=/home/arai/projects/sage
# /snap/bin: the extraction pipeline runs the `opencode` CLI, installed as a snap at /snap/bin/opencode.
# Without it every extraction started from the public URL died at Citation ("opencode executable not found").
Environment="PATH=/home/arai/projects/sage/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/snap/bin"
ExecStart=/home/arai/projects/sage/.venv/bin/streamlit run /home/arai/projects/sage/streamlit_app/app.py --server.address=127.0.0.1 --server.port=8501 --server.headless=true --server.enableWebsocketCompression=false --browser.gatherUsageStats=false
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
