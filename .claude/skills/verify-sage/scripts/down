#!/bin/sh
# Stop the instance this root started and delete its scratch data. The evidence folder stays.
# Usage: down <root>
set -u
root=$1
. "$root/instance.env"
# The runner is detached and would linger until idle, so it goes too; SIGTERM stops its runs the way Stop does.
# runner.pid can outlive its process, so the pid has to still be a sage runner before it is killed.
runner=$(cat "$SAGE_HOME/runner.pid" 2>/dev/null || true)
[ -n "$runner" ] && ps -p "$runner" -o command= 2>/dev/null | grep -q 'sage runner' || runner=""
for pid in "$SAGE_VERIFY_LISTENER" "$SAGE_VERIFY_PID" "$runner"; do
  [ -n "$pid" ] && kill "$pid" 2>/dev/null
done
sleep 0.5
lsof -t -iTCP:"$SAGE_VERIFY_PORT" -sTCP:LISTEN >/dev/null 2>&1 && echo "port $SAGE_VERIFY_PORT still held" >&2
rm -rf "$root/home" "$root/config.toml"
echo "stopped; evidence kept in $root/evidence"
